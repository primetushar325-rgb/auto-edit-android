<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (minSdk 26, so this covers every supported device).
     Foreground is the user-provided AutoEdit logo (logo_autoedit.png), whose
     baked-in dark background matches @color/ic_launcher_background seamlessly. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/logo_autoedit" />
</adaptive-icon>
